{
  "name": "weareit",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm db:prepare && turbo dev",
    "web": "turbo web --filter=@it/app",
    "ios": "turbo ios --filter=@it/app",
    "api": "pnpm --filter @it/api-server dev",
    "db:up:docker": "docker compose up -d postgres",
    "db:down:docker": "docker compose down",
    "db:migrate": "pnpm --filter @it/database db:migrate",
    "db:prepare": "pnpm --filter @it/database db:prepare",
    "db:seed": "pnpm --filter @it/database db:seed",
    "db:types": "pnpm --filter @it/database db:types",
    "test": "pnpm run test:unit && pnpm run test:expo && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:expo": "pnpm --filter @it/app test:expo",
    "test:e2e": "playwright test --config apps/app/playwright.config.ts",
    "test:tools": "python3 -m unittest discover -s tools/pains/tests && python3 -m unittest discover -s tools/possibilities/tests && python3 -m unittest discover -s tools/style/tests",
    "typecheck": "turbo typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "biome ci --error-on-warnings . && pnpm run lint:deps && eslint --max-warnings 0 . && pnpm --filter @it/content essays:check",
    "lint:deps": "depcruise apps packages tools *.mts --output-type err-long",
    "knip": "knip",
    "sherif": "sherif --fail-on-warnings",
    "format": "biome format --write .",
    "storybook": "pnpm --filter @it/app storybook",
    "storybook:review": "pnpm --filter @it/app storybook:review"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.41.0",
    "lefthook": "2.1.17",
    "sherif": "1.13.0",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.4"
  }
}
