{
  "name": "weareit",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "web": "turbo web --filter=@it/app",
    "ios": "turbo ios --filter=@it/app",
    "api": "pnpm --filter @it/api-server dev",
    "db:up:docker": "docker compose up -d postgres",
    "db:down:docker": "docker compose down",
    "db:migrate": "pnpm --filter @it/database db:migrate",
    "db:seed": "pnpm --filter @it/database db:seed",
    "test": "pnpm run test:unit && pnpm run test:expo && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:expo": "pnpm --filter @it/app test:expo",
    "test:e2e": "playwright test --config apps/app/playwright.config.ts",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  }
}
