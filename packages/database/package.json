{
  "name": "@it/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./database": "./src/database.ts",
    "./content-repository": "./src/content-repository.ts",
    "./support-repository": "./src/support-repository.ts",
    "./readiness": "./src/readiness.ts"
  },
  "dependencies": {
    "@it/content": "workspace:*",
    "@it/domain": "workspace:*",
    "@it/log": "workspace:*",
    "kysely": "^0.28.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "0.20.0",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx scripts/migrate.ts",
    "db:prepare": "node --env-file-if-exists=../../.env --import tsx scripts/prepare-local.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx scripts/seed.ts",
    "db:types": "node --env-file-if-exists=../../.env --import tsx scripts/generate-types.ts",
    "typecheck": "tsc --noEmit"
  }
}
