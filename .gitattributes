# Files with very long machine-made lines: `-diff` makes `git diff` and `git grep -I` treat
# them as binary, so a search or diff does not dump them. `linguist-generated` also
# collapses them in GitHub pull requests.

# Bundled single-file HTML previews.
docs/brand/*.html -diff

# Research pages built from tools/possibilities templates, with each run's items as one JSON line.
docs/research/possibilities/**/*.html -diff linguist-generated

# Generated by tools/icon-trace/trace_icons.py; change the script, not this file.
apps/app/src/content/group-icon-art.ts -diff linguist-generated

# Closed pain catalog batches, one input file per JSON line (tools/pains/catalog.py archive).
docs/research/pains/archive/*.jsonl -diff linguist-generated
