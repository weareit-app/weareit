{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "brand-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/brand"
      ],
      "port": 4180
    },
    {
      "name": "pain-review",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4174",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/research/pains"
      ],
      "port": 4174
    },
    {
      "name": "dream-review",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4175",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/research/possibilities/runs"
      ],
      "port": 4175
    },
    {
      "name": "fix-review",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4176",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/research/possibilities/runs"
      ],
      "port": 4176
    },
    {
      "name": "app-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@it/app",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@it/api-server",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@it/app",
        "storybook"
      ],
      "port": 6006
    }
  ]
}
