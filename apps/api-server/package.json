    "@types/nodemailer": "^7.0.12",
    "better-auth": "1.7.8",
    "nodemailer": "^7.0.13",
    "stripe": "^23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@scalar/api-reference": "1.75.1",
    "@types/node": "^26.6.5",
    "kysely": "^0.28.17",
    "tsx": "^4.21.0"
