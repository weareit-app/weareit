{
  "name": "@it/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "dev:mock": "node --env-file-if-exists=../../.env --import tsx src/start-local-mock.ts",
    "mock-stripe": "node --watch --env-file-if-exists=../../.env --import tsx src/mock-stripe.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src tests"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.8",
    "@it/api": "workspace:*",
    "@it/database": "workspace:*",
    "@orpc/server": "^1.15.6",
    "@types/nodemailer": "^7.0.12",
    "better-auth": "1.7.8",
    "nodemailer": "^7.0.13",
    "stripe": "^23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.21.0"
  }
}
