{
  "expo": {
    "name": "We Are It",
    "slug": "weareit",
    "scheme": "weareit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "default": false
          }
        }
      ],
      "expo-sqlite",
      "./plugins/with-quoted-rn-xcode-script",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "app.weareit",
      "appleTeamId": "N9PZ6BA6J6"
    }
  }
}
