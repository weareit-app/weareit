# Server and database variables; the app's public ones are in apps/app/.env.example.
NODE_ENV=development
DATABASE_URL=postgres://it:it@localhost:5432/it_dev
CMS_ADMIN_TOKEN=replace-with-a-long-random-secret
PORT=3001
# debug, info, warn, or error; info when unset.
LOG_LEVEL=
# The dev script sets API_DOCS=1 to serve /docs.
API_DOCS=
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Email sign-in codes. All four of host, user, password, and from, or none;
# without them, development logs the codes instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost:8082
# Stripe and RevenueCat are each all-or-none, and required in production.
STRIPE_SECRET_KEY=
STRIPE_SUPPORT_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=
# Optional local Stripe API mock origin. Never set in production.
STRIPE_API_BASE=
REVENUECAT_WEBHOOK_SECRET=
# The local Stripe simulator (`pnpm --filter @it/api-server mock-stripe`) and
# `dev:mock`; 12111 and http://localhost:3001 when unset.
MOCK_STRIPE_PORT=
MOCK_IT_API_BASE=
