# The one definition of what Prettier formats, used by `pnpm run format`, the CI check
# (`pnpm run lint`) and the Lefthook pre-commit hook: code only. Docs, research data and
# vendored skills are deliberately not Prettier-formatted. `.gitignore` also applies.
*
!*/
!*.ts
!*.tsx
!*.mts
!*.cts
!*.js
!*.jsx
!*.mjs
!*.cjs

.claude/
.agents/

# Expo rewrites this on every start, unformatted. apps/app/.gitignore lists it, but
# Prettier reads only the root .gitignore.
apps/app/expo-env.d.ts

# Generated by kysely-codegen (`pnpm db:types`); CI's `--verify` compares it byte for byte
# with fresh output, so it stays as generated.
packages/database/src/db.ts
