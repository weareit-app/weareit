{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // `files.includes` is the one definition of what Biome formats, used by
  // `pnpm run format`, the CI check (`pnpm run lint`), the Lefthook pre-commit
  // hook, and the essay build: code only. Docs, research data, and vendored
  // skills are deliberately not formatted. `.gitignore` also applies.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "!.claude",
      "!.agents",
      // Expo rewrites this on every start, unformatted.
      "!apps/app/expo-env.d.ts",
      // Generated by kysely-codegen (`pnpm db:types`); CI's `--verify` compares
      // it byte for byte with fresh output, so it stays as generated.
      "!packages/database/src/db.ts"
    ]
  },
  // Prettier's defaults, which the code was formatted with until 2026-10.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  // Lint: the recommended rules plus the React and project domains (#148). The
  // two hook rules are off because the type-aware ESLint pass owns every hook
  // rule. Warnings fail CI and the hook (`--error-on-warnings`), so a rule is
  // either an error or off. A suppression needs a reason after the colon.
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      // Recommended rules that Biome 2.5.15 reports as "info" by default, which
      // no CLI flag fails on, are raised to "error" (`biome explain <rule>`,
      // checked 2026-10-25). Recheck the list after a Biome upgrade.
      "complexity": {
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "useParseIntRadix": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noProcessEnv": "error",
        "useArrayLiterals": "error",
        "useExponentiationOperator": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noDuplicateFields": "error",
        "noQuickfixBiome": "error"
      }
    }
  },
  "overrides": [
    // Only each program's env file reads the environment (#171).
    {
      "includes": ["**/env.ts", "packages/database/src/test-env.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    // Non-null assertions are fine in tests, the Playwright specs, and tools/ (#148).
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.*.tsx",
        "apps/app/e2e/**",
        "tools/**"
      ],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ],
  "assist": {
    "enabled": false
  }
}
